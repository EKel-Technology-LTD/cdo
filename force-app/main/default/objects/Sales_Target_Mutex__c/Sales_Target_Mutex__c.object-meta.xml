<?xml version="1.0" encoding="UTF-8" ?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <description
  >System-only org-wide mutex for sales target launch, recovery, schedule creation and stop. A separately authorized release provisions exactly one DAILY_ACTUALS row bound to its designated machine. Runtime paths never provision it.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>false</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableReports>false</enableReports>
    <enableSearch>false</enableSearch>
    <enableSharing>false</enableSharing>
    <enableStreamingApi>false</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <!-- Mandatory release prerequisite: Grant Access Using Hierarchies must be
         disabled and independently VERIFIED on this exact target before any
         persistent DAILY_ACTUALS mutex-record provisioning or activation.
         The unsupported grantAccessUsingHierarchies XML property is deliberately
         omitted under the approved source-only correction; omission and successful
         check-only validation are NOT evidence that hierarchy access is disabled.
         Retain target-bound verification evidence with the release approval;
         missing or inconclusive evidence blocks provisioning and activation.
         Private sharing, no CRUD grants and fail-closed machine binding remain
         mandatory. This source change authorizes no org writes. -->
    <label>Sales Target Mutex</label>
    <nameField><displayFormat>STM-{000000}</displayFormat><label
    >Mutex Number</label><type>AutoNumber</type></nameField>
    <pluralLabel>Sales Target Mutexes</pluralLabel>
    <sharingModel>Private</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
