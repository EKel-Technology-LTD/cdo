<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Extended_Warranty_Range</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISBLANK(Extended_Warranty_Months__c)),OR(Extended_Warranty_Months__c&lt;0,Extended_Warranty_Months__c&gt;36))</errorConditionFormula>
    <errorMessage>延長保固月數必須介於 0 到 36。</errorMessage>
</ValidationRule>
