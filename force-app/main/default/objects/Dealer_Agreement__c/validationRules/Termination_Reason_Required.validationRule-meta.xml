<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Termination_Reason_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(Agreement_Status__c,"Terminated"),ISBLANK(TRIM(Termination_Reason__c)))</errorConditionFormula>
    <errorDisplayField>Termination_Reason__c</errorDisplayField>
    <errorMessage>Please enter a termination reason when terminating the agreement.</errorMessage>
</ValidationRule>
