<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Active_Sales_Rep_On_Assignment</fullName>
    <active>true</active>
    <errorConditionFormula>AND(OR(ISNEW(),ISCHANGED(Sales_Rep__c)),NOT(Sales_Rep__r.IsActive))</errorConditionFormula>
    <errorDisplayField>Sales_Rep__c</errorDisplayField>
    <errorMessage>Choose an active Sales Rep.</errorMessage>
</ValidationRule>
