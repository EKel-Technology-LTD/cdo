<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Closed_Requires_Resolution_Code</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(Status,"Closed"), ISBLANK(TEXT(Resolution_Code__c)))</errorConditionFormula>
    <errorDisplayField>Resolution_Code__c</errorDisplayField>
    <errorMessage>結案前請選擇結案代碼。</errorMessage>
</ValidationRule>
