<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Active_Requires_Model_And_Line</fullName>
    <active>true</active>
    <errorConditionFormula>AND(IsActive, OR(ISBLANK(Model_Number__c), ISBLANK(TEXT(Product_Line__c))))</errorConditionFormula>
    <errorMessage>啟用中的產品必須填寫產品型號與產品線。</errorMessage>
</ValidationRule>
