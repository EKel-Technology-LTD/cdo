<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Create_Followup</name>
        <label>建立首次跟進</label>
        <locationX>176</locationX>
        <locationY>200</locationY>
        <actionName>DemoLeadFollowupAction</actionName>
        <actionType>apex</actionType>
        <connector><targetReference>Check_Result</targetReference></connector>
        <faultConnector><targetReference>Action_Fault</targetReference></faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters><name>leadId</name><value><elementReference>$Record.Id</elementReference></value></inputParameters>
        <inputParameters><name>priorIntent</name><value><elementReference>Prior_Intent</elementReference></value></inputParameters>
        <inputParameters><name>isNew</name><value><elementReference>Is_New</elementReference></value></inputParameters>
        <nameSegment>DemoLeadFollowupAction</nameSegment>
        <offset>0</offset>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>67.0</apiVersion>
    <customErrors>
        <name>Action_Fault</name>
        <label>回復儲存：動作失敗</label>
        <locationX>440</locationX><locationY>308</locationY>
        <customErrorMessages><errorMessage>無法建立跟進任務，請確認名單擁有者可承接任務及必要設定後重新儲存。本次儲存未完成，請保留錯誤碼、重新整理確認資料，修正原因後再手動送出；不要連續重複送出。</errorMessage><isFieldError>false</isFieldError></customErrorMessages>
    </customErrors>
    <customErrors>
        <name>Result_Error</name>
        <label>回復儲存：逐筆失敗</label>
        <locationX>176</locationX><locationY>524</locationY>
        <customErrorMessages><errorMessage>{!Create_Followup.errorMessage}。本次儲存未完成，請保留錯誤碼、重新整理確認資料，修正原因後再手動送出；不要連續重複送出。</errorMessage><isFieldError>false</isFieldError></customErrorMessages>
    </customErrors>
    <decisions>
        <name>Check_Result</name><label>確認逐筆結果</label>
        <locationX>176</locationX><locationY>308</locationY>
        <defaultConnector><targetReference>Result_Error</targetReference></defaultConnector>
        <defaultConnectorLabel>失敗或未回傳成功</defaultConnectorLabel>
        <rules><name>Success</name><conditionLogic>and</conditionLogic>
            <conditions><leftValueReference>Create_Followup.isSuccess</leftValueReference><operator>EqualTo</operator><rightValue><booleanValue>true</booleanValue></rightValue></conditions>
            <label>成功</label>
        </rules>
    </decisions>
    <description>OD-1：同步儲存後、防重父鎖、失敗回復。無背景重試、回填或通知；僅限餐會合成名單。</description>
    <environments>Default</environments>
    <formulas><name>Is_New</name><dataType>Boolean</dataType><expression>ISNEW()</expression></formulas>
    <formulas><name>Prior_Intent</name><dataType>String</dataType><expression>TEXT({!$Record__Prior.Demo_Followup_Intent__c})</expression></formulas>
    <interviewLabel>餐會首次跟進 {!$Flow.CurrentDateTime}</interviewLabel>
    <label>餐會高意圖名單首次跟進</label>
    <processMetadataValues><name>BuilderType</name><value><stringValue>LightningFlowBuilder</stringValue></value></processMetadataValues>
    <processMetadataValues><name>CanvasMode</name><value><stringValue>AUTO_LAYOUT_CANVAS</stringValue></value></processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX><locationY>0</locationY>
        <connector><targetReference>Create_Followup</targetReference></connector>
        <filterFormula>AND(EXACT({!$Record.Demo_Event_Code__c}, "CDO-BANQUET-DEMO"), NOT({!$Record.IsConverted}), ISPICKVAL({!$Record.Demo_Followup_Intent__c}, "High"), OR(ISNEW(), NOT(ISPICKVAL({!$Record__Prior.Demo_Followup_Intent__c}, "High"))))</filterFormula>
        <object>Lead</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
