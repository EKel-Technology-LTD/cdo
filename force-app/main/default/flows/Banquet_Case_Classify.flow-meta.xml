<?xml version='1.0' encoding='UTF-8'?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Validate_Record_Id</name>
        <label>驗證原紀錄識別</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Read_Error</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>其他情況</defaultConnectorLabel>
        <rules>
            <name>Valid_Case_Id</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ValidRecordId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Read_Case</targetReference>
            </connector>
            <label>有效 Case 識別</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Initial</name>
        <label>確認可讀紀錄與活動</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Outside_Event</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>其他情況</defaultConnectorLabel>
        <rules>
            <name>Check_Initial_Missing</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Read_Case.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Read_Error</targetReference>
            </connector>
            <label>無法讀取</label>
        </rules>
        <rules>
            <name>Check_Initial_Eligible</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Read_Case.Demo_Event_Code__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>CDO-BANQUET-DEMO</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Edit_Classification</targetReference>
            </connector>
            <label>符合餐會活動</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Before_Save</name>
        <label>確認可讀紀錄與活動</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Outside_Event</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>其他情況</defaultConnectorLabel>
        <rules>
            <name>Check_Before_Save_Missing</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Recheck_Case.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Read_Error</targetReference>
            </connector>
            <label>無法讀取</label>
        </rules>
        <rules>
            <name>Check_Before_Save_Eligible</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Recheck_Case.Demo_Event_Code__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>CDO-BANQUET-DEMO</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Save_Classification</targetReference>
            </connector>
            <label>符合餐會活動</label>
        </rules>
    </decisions>
    <decisions>
        <name>Verify_Result</name>
        <label>核對原紀錄儲存結果</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Unconfirmed</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>其他情況</defaultConnectorLabel>
        <rules>
            <name>Values_Match</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Read_Back.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Read_Back.Demo_Event_Code__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>CDO-BANQUET-DEMO</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>SavedValuesMatch</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Saved</targetReference>
            </connector>
            <label>三值一致</label>
        </rules>
    </decisions>
    <description>CDO-48：由 Case 記錄動作直接以使用者模式執行。只處理原 recordId 與餐會活動；僅明確儲存時更新三個分類欄位。禁止以系統模式流程或 Apex 呼叫。</description>
    <dynamicChoiceSets>
        <name>TopicChoices</name>
        <dataType>Picklist</dataType>
        <displayField />
        <object />
        <picklistField>Demo_Inquiry_Topic__c</picklistField>
        <picklistObject>Case</picklistObject>
    </dynamicChoiceSets>
    <dynamicChoiceSets>
        <name>ImpactChoices</name>
        <dataType>Picklist</dataType>
        <displayField />
        <object />
        <picklistField>Demo_Impact__c</picklistField>
        <picklistObject>Case</picklistObject>
    </dynamicChoiceSets>
    <dynamicChoiceSets>
        <name>ProgressChoices</name>
        <dataType>Picklist</dataType>
        <displayField />
        <object />
        <picklistField>Demo_Response_Stage__c</picklistField>
        <picklistObject>Case</picklistObject>
    </dynamicChoiceSets>
    <formulas>
        <name>ValidRecordId</name>
        <dataType>Boolean</dataType>
        <expression>AND(NOT(ISBLANK({!recordId})), REGEX({!recordId}, "500[a-zA-Z0-9]{12}([a-zA-Z0-9]{3})?"))</expression>
    </formulas>
    <formulas>
        <name>SavedValuesMatch</name>
        <dataType>Boolean</dataType>
        <expression>AND(BLANKVALUE(TEXT({!Read_Back.Demo_Inquiry_Topic__c}), "") = BLANKVALUE({!TopicInput}, ""), BLANKVALUE(TEXT({!Read_Back.Demo_Impact__c}), "") = BLANKVALUE({!ImpactInput}, ""), BLANKVALUE(TEXT({!Read_Back.Demo_Response_Stage__c}), "") = BLANKVALUE({!ProgressInput}, ""))</expression>
    </formulas>
    <formulas>
        <name>BeforeTopicLabel</name>
        <dataType>String</dataType>
        <expression>CASE(TEXT({!Read_Case.Demo_Inquiry_Topic__c}), "Product Introduction", "產品介紹", "Operation Assistance", "操作協助", "Service Anomaly", "服務異常", BLANKVALUE(TEXT({!Read_Case.Demo_Inquiry_Topic__c}), "（未選擇）"))</expression>
    </formulas>
    <formulas>
        <name>AfterTopicLabel</name>
        <dataType>String</dataType>
        <expression>CASE({!TopicInput}, "Product Introduction", "產品介紹", "Operation Assistance", "操作協助", "Service Anomaly", "服務異常", BLANKVALUE({!TopicInput}, "（未選擇）"))</expression>
    </formulas>
    <formulas>
        <name>BeforeImpactLabel</name>
        <dataType>String</dataType>
        <expression>CASE(TEXT({!Read_Case.Demo_Impact__c}), "Single User", "單一使用者", "Multiple Users", "多位使用者", "Unavailable", "無法使用", BLANKVALUE(TEXT({!Read_Case.Demo_Impact__c}), "（未選擇）"))</expression>
    </formulas>
    <formulas>
        <name>AfterImpactLabel</name>
        <dataType>String</dataType>
        <expression>CASE({!ImpactInput}, "Single User", "單一使用者", "Multiple Users", "多位使用者", "Unavailable", "無法使用", BLANKVALUE({!ImpactInput}, "（未選擇）"))</expression>
    </formulas>
    <formulas>
        <name>BeforeProgressLabel</name>
        <dataType>String</dataType>
        <expression>CASE(TEXT({!Read_Case.Demo_Response_Stage__c}), "Not Yet Responded", "尚未回覆", "In Progress", "處理中", "Responded", "已回覆", BLANKVALUE(TEXT({!Read_Case.Demo_Response_Stage__c}), "（未選擇）"))</expression>
    </formulas>
    <formulas>
        <name>AfterProgressLabel</name>
        <dataType>String</dataType>
        <expression>CASE({!ProgressInput}, "Not Yet Responded", "尚未回覆", "In Progress", "處理中", "Responded", "已回覆", BLANKVALUE({!ProgressInput}, "（未選擇）"))</expression>
    </formulas>
    <interviewLabel>整理餐會諮詢 {!$Flow.CurrentDateTime}</interviewLabel>
    <isAdditionalPermissionRequiredToRun>true</isAdditionalPermissionRequiredToRun>
    <label>整理餐會諮詢</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <name>Read_Case</name>
        <label>讀取原諮詢</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Initial</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Read_Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Case</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Demo_Event_Code__c</queriedFields>
        <queriedFields>Demo_Inquiry_Topic__c</queriedFields>
        <queriedFields>Demo_Impact__c</queriedFields>
        <queriedFields>Demo_Response_Stage__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Recheck_Case</name>
        <label>儲存前重查原諮詢</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Before_Save</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Read_Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Case</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Demo_Event_Code__c</queriedFields>
        <queriedFields>Demo_Inquiry_Topic__c</queriedFields>
        <queriedFields>Demo_Impact__c</queriedFields>
        <queriedFields>Demo_Response_Stage__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Read_Back</name>
        <label>讀回原諮詢</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Verify_Result</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Unconfirmed</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Case</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Demo_Event_Code__c</queriedFields>
        <queriedFields>Demo_Inquiry_Topic__c</queriedFields>
        <queriedFields>Demo_Impact__c</queriedFields>
        <queriedFields>Demo_Response_Stage__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Save_Classification</name>
        <label>儲存三項分類</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Read_Back</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Write_Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Demo_Event_Code__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>CDO-BANQUET-DEMO</stringValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Demo_Inquiry_Topic__c</field>
            <value>
                <elementReference>TopicInput</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Demo_Impact__c</field>
            <value>
                <elementReference>ImpactInput</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Demo_Response_Stage__c</field>
            <value>
                <elementReference>ProgressInput</elementReference>
            </value>
        </inputAssignments>
        <object>Case</object>
    </recordUpdates>
    <runInMode>DefaultMode</runInMode>
    <screens>
        <name>Edit_Classification</name>
        <label>整理餐會諮詢</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Confirm_Summary</targetReference>
        </connector>
        <fields>
            <name>Edit_Help</name>
            <fieldText>&lt;p&gt;活動：CDO-BANQUET-DEMO。關閉視窗即可取消，尚未儲存。&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>TopicInput</name>
            <choiceReferences>TopicChoices</choiceReferences>
            <dataType>String</dataType>
