            </defaultValue>
            <fieldText>影響程度</fieldText>
            <fieldType>DropdownBox</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <fields>
            <name>ProgressInput</name>
            <choiceReferences>ProgressChoices</choiceReferences>
            <dataType>String</dataType>
            <defaultValue>
                <elementReference>Read_Case.Demo_Response_Stage__c</elementReference>
            </defaultValue>
            <fieldText>回覆進度</fieldText>
            <fieldType>DropdownBox</fieldType>
