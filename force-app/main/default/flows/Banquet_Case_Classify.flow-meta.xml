    <screens>
        <name>Confirm_Summary</name>
        <label>確認摘要</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <backButtonLabel>上一步</backButtonLabel>
        <connector>
            <targetReference>Recheck_Case</targetReference>
