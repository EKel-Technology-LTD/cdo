        <fields>
            <name>Summary_Help</name>
            <fieldText>&lt;p&gt;請核對三項分類，按「儲存」才會更新原紀錄。關閉視窗即可取消，尚未儲存。&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>Summary_Topic</name>
            <fieldText>&lt;p&gt;諮詢主題：{!BeforeTopicLabel} → {!AfterTopicLabel}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>Summary_Impact</name>
            <fieldText>&lt;p&gt;影響程度：{!BeforeImpactLabel} → {!AfterImpactLabel}&lt;/p&gt;</fieldText>
